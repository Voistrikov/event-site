JWT_SECRET=replace-with-at-least-32-random-characters
DB_USER=events_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=events_db
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password
